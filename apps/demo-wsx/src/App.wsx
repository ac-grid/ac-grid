/** @jsxImportSource @wsxjs/wsx-core */

import { LightComponent, autoRegister, state } from "@wsxjs/wsx-core";
import "@ac-grid/core";
import { makeData, type Person } from "./makeData";
import "./App.css";

import "./components/DemoBasicGrid.wsx";
import "./components/DemoSortingGrid.wsx";
import "./components/DemoFilteringGrid.wsx";
import "./components/DemoResizingGrid.wsx";
import "./components/DemoSelectionGrid.wsx";
import "./components/DemoPaginationGrid.wsx";

type DemoTab = "basic" | "sorting" | "filtering" | "resizing" | "selection" | "pagination";

@autoRegister({ tagName: "wsx-app" })
export class App extends LightComponent {
    @state private activeTab: DemoTab = "basic";
    @state private data: Person[] = makeData(500);

    render() {
        return (
            <div className="demo-container">
                <div className="demo-content">
                    <div className="demo-header">
                        <h1>
                            <img src="/favicon.svg" alt="Logo" className="demo-logo" />
                            AC Grid
                        </h1>
                        <div className="subtitle">Feature demos</div>
                    </div>

                    <div className="demo-tabs">
                        <button
                            type="button"
                            className={`demo-tab ${this.activeTab === "basic" ? "active" : ""}`}
                            onClick={() => (this.activeTab = "basic")}
                        >
                            Basic
                        </button>
                        <button
                            type="button"
                            className={`demo-tab ${this.activeTab === "sorting" ? "active" : ""}`}
                            onClick={() => (this.activeTab = "sorting")}
                        >
                            Sorting
                        </button>
                        <button
                            type="button"
                            className={`demo-tab ${this.activeTab === "filtering" ? "active" : ""}`}
                            onClick={() => (this.activeTab = "filtering")}
                        >
                            Filtering
                        </button>
                        <button
                            type="button"
                            className={`demo-tab ${this.activeTab === "resizing" ? "active" : ""}`}
                            onClick={() => (this.activeTab = "resizing")}
                        >
                            Resizing
                        </button>
                        <button
                            type="button"
                            className={`demo-tab ${this.activeTab === "selection" ? "active" : ""}`}
                            onClick={() => (this.activeTab = "selection")}
                        >
                            Selection
                        </button>
                        <button
                            type="button"
                            className={`demo-tab ${this.activeTab === "pagination" ? "active" : ""}`}
                            onClick={() => (this.activeTab = "pagination")}
                        >
                            Pagination
                        </button>
                    </div>

                    <div className="demo-feature-info">{this.getFeatureDescription()}</div>

                    <div className="demo-grid-container">
                        <div className="demo-grid-wrapper">
                            {this.activeTab === "basic" && (
                                <demo-basic-grid data={this.data} />
                            )}
                            {this.activeTab === "sorting" && (
                                <demo-sorting-grid data={this.data} />
                            )}
                            {this.activeTab === "filtering" && (
                                <demo-filtering-grid data={this.data} />
                            )}
                            {this.activeTab === "resizing" && (
                                <demo-resizing-grid data={this.data} />
                            )}
                            {this.activeTab === "selection" && (
                                <demo-selection-grid data={this.data} />
                            )}
                            {this.activeTab === "pagination" && (
                                <demo-pagination-grid data={this.data} />
                            )}
                        </div>
                    </div>

                    <div className="demo-footer">{this.getFeatureTips()}</div>
                </div>
            </div>
        );
    }

    private getFeatureDescription(): string {
        if (this.activeTab === "basic") return "Simple data grid with basic rendering (500 rows)";
        if (this.activeTab === "sorting") return "Click column headers to sort ascending → descending → none";
        if (this.activeTab === "filtering") return "Use column filters (click icon) or global search box above";
        if (this.activeTab === "resizing") return "Drag column borders to resize. Double-click border for auto-size";
        if (this.activeTab === "selection") return "Click checkboxes to select rows. Header checkbox selects all";
        if (this.activeTab === "pagination") return "Use page controls to navigate. Change page size with dropdown";
        return "";
    }

    private getFeatureTips() {
        if (this.activeTab === "basic") return <p>Basic grid rendering with 500 rows of sample data.</p>;
        if (this.activeTab === "sorting") return <p>Shift+click for multi-column sorting. Click again to cycle through sort states.</p>;
        if (this.activeTab === "filtering") return <p>For number columns: use expressions like &quot;&gt;30&quot; or &quot;25-35&quot; for ranges.</p>;
        if (this.activeTab === "resizing") return <p>Each column has min/max width limits. Double-click border auto-sizes to content.</p>;
        if (this.activeTab === "selection") return <p>Single mode: click row to select. Multiple mode: use checkboxes.</p>;
        if (this.activeTab === "pagination") return <p>Shows current page, total rows, and allows changing page size.</p>;
        return <p />;
    }
}
