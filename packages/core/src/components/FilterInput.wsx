/** @jsxImportSource @wsxjs/wsx-core */
import { LightComponent, state, autoRegister } from "@wsxjs/wsx-core";
import type { Column } from "@tanstack/table-core";
import { type ColumnDef } from "../types/column";
import { type FilterCondition, type FilterOperator } from "../types/filtering";
import "./Dropdown.wsx";

export interface FilterInputProps {
    column: Column<any, unknown>;
    value: FilterCondition | string;
    onChange: (condition: FilterCondition) => void;
}

@autoRegister({ tagName: "wsx-ac-filter-input" })
export class FilterInput extends LightComponent {
    get column(): Column<any, unknown> { return this._column; }
    set column(val: Column<any, unknown>) { this._column = val; }
    private _column: Column<any, unknown> = null as any;

    get value(): FilterCondition | string { return this._value; }
    set value(val: FilterCondition | string) {
        if (val !== this._value) {
            this._value = val;
            this.parseValue(val);
        }
    }
    private _value: FilterCondition | string = "";

    get onChange(): ((condition: FilterCondition) => void) | undefined { return this._onChange; }
    set onChange(val: ((condition: FilterCondition) => void) | undefined) { this._onChange = val; }
    private _onChange: ((condition: FilterCondition) => void) | undefined;

    get variant(): "default" | "floating" { return this._variant; }
    set variant(val: "default" | "floating") { this._variant = val; }
    private _variant: "default" | "floating" = "default";

    @state private inputValue: string = "";
    @state private operator: FilterOperator = "contains";

    onConnected() {
        super.onConnected?.();
        const el = this as any;
        if (el.column) this.column = el.column;
        if (el.value !== undefined) this.value = el.value;
        if (el.onChange) this.onChange = el.onChange;
        if (el.variant) this.variant = el.variant;
    }

    private parseValue(val: FilterCondition | string) {
        if (typeof val === "string") {
            // 字符串输入：设置值并根据列类型选择默认操作符
            this.inputValue = val || "";
            const colDef = this._column?.columnDef as ColumnDef<any>;
            const isNumber = colDef?.filterType === "number";
            this.operator = isNumber ? "equals" : "contains";
        } else {
            // FilterCondition 对象输入：直接解构赋值
            this.inputValue = val.value ?? "";
            this.operator = val.operator ?? "contains";
        }
    }

    private emitChange() {
        const payload: FilterCondition = {
            value: this.inputValue,
            operator: this.operator
        };
        this._onChange?.(payload);
    }

    private handleInput = (e: Event) => {
        this.inputValue = (e.target as HTMLInputElement).value;
        this.emitChange();
    };

    private handleOperatorChange = (e: Event) => {
        this.operator = (e.target as HTMLSelectElement).value;
        this.emitChange();
    };

    /** Dropdown operator change handler (receives operator string directly) */
    private handleDropdownChange = (newOperator: FilterOperator) => {
        this.operator = newOperator;
        this.emitChange();
    };

    render() {
        // 获取列定义，判断过滤类型
        const colDef = this._column?.columnDef as ColumnDef<any>;
        const type = colDef?.filterType === "number" ? "number" : "text";

        // 数字过滤选项
        const numberOptions = [
            { value: "equals", label: "Equals" },
            { value: "greaterThan", label: "Greater than" },
            { value: "lessThan", label: "Less than" },
        ];

        // 文本过滤选项
        const textOptions = [
            { value: "contains", label: "Contains" },
            { value: "notContains", label: "Not contains" },
            { value: "equals", label: "Equals" },
            { value: "notEqual", label: "Not equal" },
            { value: "startsWith", label: "Starts with" },
            { value: "endsWith", label: "Ends with" },
            { value: "blank", label: "Blank" },
            { value: "notBlank", label: "Not blank" },
        ];

        // 数字类型过滤 UI
        if (type === "number") {
            return (
                <div className="filter-input-container">
                    <wsx-ac-dropdown
                        options={numberOptions}
                        value={this.operator}
                        onChange={this.handleDropdownChange}
                        placeholder="Select operator"
                    />
                    <input
                        type="number"
                        className="filter-input"
                        value={this.inputValue}
                        onInput={this.handleInput}
                        placeholder="Filter number..."
                    />
                </div>
            );
        }

        // 浮动过滤器（简化 UI，只显示输入框）
        if (this._variant === "floating") {
            return (
                <div className="filter-input-container floating">
                    <input
                        type="text"
                        className="filter-input floating"
                        value={this.inputValue}
                        onInput={this.handleInput}
                        placeholder="Filter..."
                        disabled={this.operator === 'blank' || this.operator === 'notBlank'}
                    />
                </div>
            );
        }

        // 默认文本类型过滤 UI
        return (
            <div className="filter-input-container">
                <wsx-ac-dropdown
                    options={textOptions}
                    value={this.operator}
                    onChange={this.handleDropdownChange}
                    placeholder="Select operator"
                />
                <input
                    type="text"
                    className="filter-input"
                    value={this.inputValue}
                    onInput={this.handleInput}
                    placeholder="Filter..."
                    disabled={this.operator === 'blank' || this.operator === 'notBlank'}
                />
            </div>
        );
    }
}
