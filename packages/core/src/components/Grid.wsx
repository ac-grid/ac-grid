import { LitElement, html } from 'lit';
import type { CSSResultGroup, TemplateResult } from 'lit';

export interface GridOptions {
  // 基础配置
  data: any[];
  columns: ColumnDef[];
  
  // 虚拟滚动配置
  enableVirtualScrolling?: boolean;
  rowHeight?: number;
  overscan?: number;
  estimateRowHeight?: (row: Row<any>) => number;
  onScroll?: (scrollTop: number) => void;
  
  // 分页配置
  paginationConfig?: GridPaginationConfig;
  
  // 其他通用配置
  headerHeight?: number;
}

export interface ColumnDef {
  accessorKey: string;
  header?: TemplateResult | string;
  cellData?: any;
  cell?: (row: Row<any>) => any;
  size?: number;
  padding?: string;
  align?: 'left' | 'center' | 'right';
}

export interface Row<T = any> {
  index: number;
  data: T;
}

export interface GridPaginationConfig {
  pageSizeOptions?: number[];
  defaultPageSize?: number;
  pageIndex?: number;
}

/**
 * 基础网格组件（支持虚拟滚动）
 */
export class Grid extends LitElement {
  static get styles(): CSSResultGroup {
    return css`
      :host {
        display: block;
        width: 100%;
        height: 100%;
        overflow: hidden;
        position: relative;
      }

      .grid-root {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        user-select: none;
      }

      :host([enable-virtual-scrolling]) {
        --virtual-scrolling: true;
      }
    `;
  }

  static properties = {
    options: { type: Object },
    data: { type: Array },
    columns: { type: Array },
    enableVirtualScrolling: { 
      type: Boolean, 
      attribute: 'enable-virtual-scrolling',
      computed: true,
    },
  };

  // 计算属性
  get visibleRowsCount(): number {
    if (!this.enableVirtualScrolling) return this.data.length;
    
    const rowHeight = this.rowHeight || DEFAULT_ROW_HEIGHT;
    const gridRef = this.renderRoot?.querySelector('.grid-container');
    return Math.floor((gridRef?.clientHeight || 0) / rowHeight);
  }

  constructor() {
    super();
    // 初始配置
    if (this.data) {
      // TODO: 初始化滚动行为等
    }
  }

  render(): TemplateResult {
    return html`
      <div class="grid-root">
        ${!this.enableVirtualScrolling 
          ? this._renderNormalGrid() 
          : this._renderVirtualGrid()}
      </div>
    `;
  }

  _renderNormalGrid(): TemplateResult {
    return html`<div class="normal-grid">
      <!-- 正常渲染所有行 -->
      <div style="display: flex; overflow-x: auto;">
        ${this.data.map((row, idx) => (
          <div 
            key={idx}
            style={
              {
                display: 'flex',
                height: `${this.rowHeight || 50}px`,
              } as CSSProperties
            }
          >
            ${this.columns.map((col) => (
              <div
                class="cell"
                style={
                  {
                    width: col.size,
                    padding: col.padding,
                  } as CSSProperties
                }
              >
                ${col.cellData || ''}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>`;
  }

  _renderVirtualGrid(): TemplateResult {
    // TODO: 使用虚拟滚动组件渲染
    return html`<div class="virtual-grid">
      <grid-virtual 
        .columns="${this.columns}"
        .data="${this.data}"
        .rowHeight="${this.rowHeight || DEFAULT_ROW_HEIGHT}"
      ></grid-virtual>
    </div>`;
  }

  // 设置行高
  set rowHeight(height: number) {
    this.rowHeight = height;
  }

  // 获取可见行范围
  getVisibleRowRange(): { start: number; end: number } | null {
    if (!this.enableVirtualScrolling) return null;
    
    const gridRef = this.renderRoot?.querySelector('.grid-container');
    if (!gridRef) return null;

    const scrollTop = gridRef.scrollTop || 0;
    const rowHeight = this.rowHeight || DEFAULT_ROW_HEIGHT;
    
    return {
      start: Math.floor(scrollTop / rowHeight),
      end: Math.min(
        Math.floor((scrollTop + gridRef.clientHeight) / rowHeight),
        this.data.length - 1
      ),
    };
  }

  // 滚动到指定行
  scrollToRow(rowIndex: number): void {
    if (!this.enableVirtualScrolling) return;

    const gridRef = this.renderRoot?.querySelector('.grid-container');
    if (!gridRef) return;

    const rowHeight = this.rowHeight || DEFAULT_ROW_HEIGHT;
    const scrollOffset = rowIndex * rowHeight + 50; // 头占位
    
    gridRef.scrollTop = scrollOffset;
  }

  // TODO: 滚动事件处理
  _handleScroll(e: Event): void {
    const target = e.target as HTMLElement;
    if (this.options.onScroll) {
      this.options.onScroll(target.scrollTop);
    }
  }
}

// 默认行高
const DEFAULT_ROW_HEIGHT = 50;
