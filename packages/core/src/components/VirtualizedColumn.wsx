import { LitElement, html } from 'lit';
import type { CSSResultGroup, TemplateResult } from 'lit';

/**
 * 虚拟化的列组件
 */
export class VirtualizedColumn extends LitElement {
  static get styles(): CSSResultGroup {
    return css`
      :host {
        display: flex;
        height: 100%;
        align-items: center;
        box-sizing: border-box;
      }

      .column-content {
        flex-shrink: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
      }
    `;
  }

  static properties = {
    headerData: { type: Object },
    cellData: { type: Object },
    width: { type: Number },
    padding: { type: String, attribute: 'data-padding' },
  };

  private _renderCell(cell: any) {
    return html`<div class="column-content">
      ${cell.render ? cell.render() : cell.data || ''}
    </div>`;
  }

  protected render(): TemplateResult {
    const cell = this.cellData || {};

    return this._renderCell(cell);
  }
}
