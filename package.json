{
    "name": "@ac-grid/monorepo",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "author": "Albert Li <albert_lee@hotmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/systembugtj/ac-grid"
    },
    "homepage": "http://systembugtj.github.io/ac-grid",
    "scripts": {
        "dev": "pangu",
        "dev:wsx": "pnpm --filter @ac-grid/demo-wsx dev",
        "dev:core": "pnpm --filter @ac-grid/core dev",
        "build": "turbo run build",
        "build:core": "pnpm --filter @ac-grid/core build",
        "build:wsx": "pnpm --filter @ac-grid/demo-wsx build",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "check:public-exports": "node scripts/check-public-exports.mjs",
        "check:layer-deps": "node scripts/check-layer-deps.mjs",
        "test:e2e": "pnpm --filter @ac-grid/demo-react test:e2e",
        "clean": "turbo run clean && rm -rf node_modules",
        "clean:vite-config-cache": "find . -name 'vite.config.ts.timestamp-*.mjs' -not -path './node_modules/*' -delete",
        "format": "prettier --write \"**/*.{ts,tsx,wsx,md,json}\"",
        "storybook": "turbo run storybook",
        "build-storybook": "turbo run build-storybook"
    },
    "devDependencies": {
        "prettier": "^3.4.2",
        "turbo": "^2.0.0",
        "typescript": "^5.6.2",
        "@systembug/pangu": "^0.0.10"
    },
    "packageManager": "pnpm@10.10.0",
    "license": "MIT",
    "pnpm": {
        "overrides": {
            "@babel/core@<7.29.6": "^7.29.6",
            "@isaacs/brace-expansion@<5.0.1": "^5.0.1",
            "ajv@>=7.0.0 <8.18.0": "^8.18.0",
            "brace-expansion@<1.1.18": "^1.1.18",
            "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
            "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
            "browserslist@<4.28.7": "^4.28.7",
            "diff@>=6.0.0 <8.0.3": "^8.0.3",
            "glob@>=9.0.0 <14.0.2": "^14.0.2",
            "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
            "lodash@>=4.0.0 <4.18.0": "^4.18.0",
            "minimatch@<3.1.4": "^3.1.4",
            "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
            "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
            "postcss-selector-parser@<6.1.5": "^6.1.5",
            "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
            "ws@>=8.0.0 <8.21.0": "^8.21.0"
        }
    }
}
